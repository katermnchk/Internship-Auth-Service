<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1-4" author="ramenchyk-katsiaryna">
        <addColumn tableName="auth_users">
            <column name="user_id" type="bigint">
                <constraints nullable="false" unique="true" />
            </column>
        </addColumn>

        <createIndex tableName="auth_users" indexName="idx_auth_users_user_id">
            <column name="user_id" />
        </createIndex>

        <rollback>
            <dropIndex tableName="auth_users" indexName="idx_auth_users_user_id" />
            <dropColumn tableName="auth_users" columnName="user_id" />
        </rollback>
    </changeSet>

</databaseChangeLog>